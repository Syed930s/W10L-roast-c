#!/usr/bin/env bash
set -u
cd "$(dirname "$0")"

SRC="${SRC:-W10L-roaster.c}"
OUT="${OUT:-Downloads}"
LOG="$(mktemp)"
OK=()
FAIL=()
SKIP=()

mkdir -p "$OUT/Linux" "$OUT/Mac" "$OUT/T2-Mac" "$OUT/Windows 32" "$OUT/Windows 64"

if [ ! -f "$SRC" ]; then
    echo "source not found: $SRC"
    exit 1
fi

have() { command -v "$1" >/dev/null 2>&1; }

step() {
    local label="$1"
    shift
    printf '%-34s' "$label"
    if "$@" >"$LOG" 2>&1; then
        echo "ok"
        OK+=("$label")
    else
        echo "FAILED"
        sed 's/^/    /' "$LOG" | head -n 15
        FAIL+=("$label")
    fi
}

skip() {
    printf '%-34s%s\n' "$1" "skipped ($2)"
    SKIP+=("$1")
}

if have gcc; then
    step "Linux x64" gcc -O2 -o "$OUT/Linux/w10l-roaster-linux-x64" "$SRC" -lcurl
else
    skip "Linux x64" "gcc missing"
fi

if have x86_64-w64-mingw32-gcc; then
    step "Windows 64" x86_64-w64-mingw32-gcc -O2 -static -o "$OUT/Windows 64/w10l-roaster-x64.exe" "$SRC" -lwinhttp
else
    skip "Windows 64" "mingw64-gcc missing"
fi

if have i686-w64-mingw32-gcc; then
    step "Windows 32" i686-w64-mingw32-gcc -O2 -static -o "$OUT/Windows 32/w10l-roaster-x86.exe" "$SRC" -lwinhttp
else
    skip "Windows 32" "mingw32-gcc missing"
fi

if have oa64-clang; then
    step "macOS Apple Silicon" oa64-clang -O2 -o "$OUT/Mac/w10l-roaster-mac-arm" "$SRC" -lcurl
else
    skip "macOS Apple Silicon" "osxcross not in PATH"
fi

if have o64-clang; then
    step "macOS Intel (T2)" o64-clang -O2 -o "$OUT/T2-Mac/T2-w10l-roaster-mac" "$SRC" -lcurl
else
    skip "macOS Intel (T2)" "osxcross not in PATH"
fi

if have lipo && [ -f "$OUT/Mac/w10l-roaster-mac-arm" ] && [ -f "$OUT/T2-Mac/T2-w10l-roaster-mac" ]; then
    step "macOS universal" lipo -create -output "$OUT/Mac/w10l-roaster-mac-universal" \
        "$OUT/Mac/w10l-roaster-mac-arm" "$OUT/T2-Mac/T2-w10l-roaster-mac"
fi

rm -f "$LOG"

echo
echo "ok: ${#OK[@]}  failed: ${#FAIL[@]}  skipped: ${#SKIP[@]}"
echo
find "$OUT" -type f -printf '%P  (%s bytes)\n' | sort

[ "${#FAIL[@]}" -eq 0 ]
